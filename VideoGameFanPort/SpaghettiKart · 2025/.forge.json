          "dest": ".build/spaghetti-mac-arm64.zip"
        },
        { "step": "extract", "src": ".build/spaghetti-mac-arm64.zip", "dest": ".build" },
        { "step": "deletePath", "path": ".build/spaghetti-mac-arm64.zip" },
        { "step": "copy", "from": "rom", "dest": "./.build/Mario Kart 64 (USA).z64" },
        {
