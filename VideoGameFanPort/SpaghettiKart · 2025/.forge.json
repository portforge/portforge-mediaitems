          "dest": "./.build/mods/mk64-reloaded-v2026.04.03-sk-${textureMod}.o2r"
        },
        { "step": "move", "src": "./.build", "dest": "./install" },
        { "step": "deletePath", "path": "./.build" },
        { "step": "defineExecutable", "executable": "install/Spaghettify", "title": "Play" }
      ]
    },
    {
