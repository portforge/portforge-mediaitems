{
  "defaultVersion": "0.2.55",
  "uninstallSteps": [
    { "step": "deletePath", "path": "install" }
  ],
  "builds": [
    {
      "versions": ["0.2.55"],
      "targetPlatforms": ["Linux-x64"],
      "dependencies": ["chmod"],
      "steps": [
        { "step": "createDir", "path": "install" },
        {
          "step": "fetch",
          "url": "https://github.com/bryanthaboi/gen1recomp/releases/download/v0.2.55/gen1recomp-0.2.55-linux-x86_64.AppImage",
          "dest": "install/gen1recomp.AppImage"
        },
        { "step": "run", "cmd": "chmod", "args": ["+x", "install/gen1recomp.AppImage"] },
        { "step": "touch", "path": "install/portable.txt" },
        { "step": "defineExecutable", "executable": "install/gen1recomp.AppImage", "title": "Play" }
      ]
    },
    {
      "versions": ["0.2.55"],
      "targetPlatforms": ["Linux-arm64"],
