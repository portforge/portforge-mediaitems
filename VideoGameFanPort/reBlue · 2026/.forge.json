{
  "defaultVersion": "1.0.0",
  "uninstallSteps": [
    { "step": "deletePath", "path": "install" }
  ],
  "builds": [
    {
      "versions": ["1.0.0"],
      "targetPlatforms": ["Linux-x64"],
      "dependencies": ["chmod"],
      "steps": [
        { "step": "createDir", "path": "install" },
        {
          "step": "fetch",
          "url": "https://github.com/zolaware/reblue/releases/download/v1.0.0/reblue-1.0.0-x86_64.AppImage",
          "dest": "install/reblue.AppImage"
        },
        { "step": "run", "cmd": "chmod", "args": ["+x", "install/reblue.AppImage"] },
        { "step": "defineExecutable", "executable": "install/reblue.AppImage", "title": "Play" }
      ]
    },
    {
      "versions": ["1.0.0"],
      "targetPlatforms": ["Linux-arm64"],
      "dependencies": ["chmod"],
      "steps": [
        { "step": "createDir", "path": "install" },
        {
          "step": "fetch",
          "url": "https://github.com/zolaware/reblue/releases/download/v1.0.0/reblue-1.0.0-aarch64.AppImage",
          "dest": "install/reblue.AppImage"
        },
        { "step": "run", "cmd": "chmod", "args": ["+x", "install/reblue.AppImage"] },
        { "step": "defineExecutable", "executable": "install/reblue.AppImage", "title": "Play" }
      ]
    },
    {
      "versions": ["1.0.0"],
      "targetPlatforms": ["Windows-x64"],
      "dependencies": [],
      "steps": [
        { "step": "createDir", "path": ".build" },
        {
          "step": "fetch",
          "url": "https://github.com/zolaware/reblue/releases/download/v1.0.0/reblue-1.0.0-win-amd64.zip",
          "dest": ".build/package.zip"
        },
        { "step": "extract", "src": ".build/package.zip", "dest": ".build" },
        { "step": "deletePath", "path": ".build/package.zip" },
        { "step": "move", "src": ".build", "dest": "install" },
        { "step": "deletePath", "path": ".build" },
        { "step": "defineExecutable", "executable": "install/reblue.exe", "title": "Play" },
        { "step": "defineExecutable", "executable": "install/reblue_vk.exe", "title": "Play (Vulkan)" }
      ]
    }
  ]
}
